<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Smart Priority Budget</title><style>:root{--sage:#829981;--cream:#f8f4ea;--amber:#f0dea5;--blush:#e9bdb9;--ink:#343731}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font:15px system-ui,sans-serif}.app{max-width:700px;margin:auto;padding:20px 16px 90px}header{display:flex;justify-content:space-between;align-items:center}h1{font-family:Georgia,serif;font-size:25px;margin:8px 0}h2{font-size:17px;margin:24px 0 12px}.muted{color:#687066;font-size:12px}.card{background:white;border-radius:16px;padding:16px;box-shadow:0 2px 8px #3331}.hero{background:#e2e9df;margin-top:18px}.money{font-size:30px;font-weight:750;margin:8px 0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.smallmoney{font-size:21px;font-weight:750;margin:7px 0}.warning{background:#f5e3b6}.danger{background:#f1d0cd}.row{display:flex;justify-content:space-between;gap:10px;padding:11px 0;border-bottom:1px solid #eee}.row:last-child{border:0}.pill{font-size:11px;border-radius:20px;padding:5px 9px;background:#f1d0cd}.good{background:#dce8da}input{width:100%;border:1px solid #c8d1c4;border-radius:10px;padding:12px;font:inherit;margin:6px 0 10px}button{background:var(--sage);border:0;color:white;border-radius:10px;padding:12px 15px;font-weight:700;cursor:pointer}.nav{position:fixed;bottom:0;left:0;right:0;background:white;border-top:1px solid #ddd;display:flex;justify-content:space-around;padding:14px 4px;font-size:12px}.nav a{color:var(--ink);text-decoration:none}.tag{background:#dfe8db;border-radius:6px;padding:4px 8px;font-size:11px}</style></head><body><main class="app"><header><div><div class="muted">PERSONAL FINANCE</div><h1>Smart Priority Budget</h1></div><span class="tag">Demo</span></header><div class="muted">Your money, organized by priority.</div><section class="card hero"><div class="muted">Available cash · sample</div><div class="money" id="cash">₱13,000</div><div class="muted">Plan your next payday before spending.</div></section><div class="grid"><section class="card"><div class="muted">Upcoming bills</div><div class="smallmoney">₱9,500</div><span class="tag">Needs</span></section><section class="card danger"><div class="muted">Debt due</div><div class="smallmoney">₱6,000</div><span class="pill">Payment alert</span></section><section class="card warning"><div class="muted">Projected shortage</div><div class="smallmoney" id="shortage">₱2,500</div><span class="tag">Adjust budget</span></section><section class="card"><div class="muted">Savings reserved</div><div class="smallmoney">₱0</div><span class="tag">After obligations</span></section></div><h2>Payday calculator</h2><section class="card"><label for="pay">Actual take-home pay (₱)</label><input id="pay" type="number" min="0" value="13000"><div class="row"><span>Needs / fixed bills</span><strong>₱9,500</strong></div><div class="row"><span>Debt payments due</span><strong>₱6,000</strong></div><div class="row"><span>Remaining after obligations</span><strong id="remaining">−₱2,500</strong></div><p class="muted">Illustrative amounts. This demo does not save transactions or track real balances yet.</p></section><h2>Upcoming payments</h2><section class="card"><div class="row"><span>House rent</span><strong>₱5,500</strong></div><div class="row"><span>Electricity</span><strong>₱2,500</strong></div><div class="row"><span>Water · sample</span><strong>₱500</strong></div><div class="row"><span>Internet · sample</span><strong>₱1,000</strong></div><div class="row"><span>Debt due · sample</span><strong>₱6,000</strong></div></section></main><nav class="nav"><a href="#">⌂ Overview</a><a href="#pay">＋ Payday</a><a href="#pay">▤ Budget</a><a href="#pay">◷ Due dates</a></nav><script>const p=document.getElementById('pay');function update(){let v=Math.max(0,Number(p.value)||0),d=v-15500;document.getElementById('cash').textContent='₱'+v.toLocaleString('en-PH');document.getElementById('remaining').textContent=(d<0?'−':'')+'₱'+Math.abs(d).toLocaleString('en-PH');document.getElementById('shortage').textContent='₱'+Math.max(0,-d).toLocaleString('en-PH')}p.addEventListener('input',update);update()</script></body></html>
